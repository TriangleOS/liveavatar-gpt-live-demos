{
  "name": "avatar-creator-service",
  "version": "1.0.0",
  "description": "Avatar Creator API - Allow users to create and manage custom live avatars with knowledge bases",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrations": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "jsonwebtoken": "^9.1.2",
    "axios": "^1.6.2",
    "form-data": "^4.0.0",
    "sqlite3": "^5.1.6",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
